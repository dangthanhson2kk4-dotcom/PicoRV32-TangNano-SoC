IO_LOC "tft_mosi" 53; 
IO_PORT "tft_mosi" IO_TYPE=LVCMOS33;

IO_LOC "tft_sck" 51;  
IO_PORT "tft_sck" IO_TYPE=LVCMOS33;

/********** BANK 3 **********/
IO_LOC "reset_n" 4; 
IO_PORT "reset_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC "led0" 10;
IO_PORT "led0" IO_TYPE=LVCMOS18;

IO_LOC "led1" 11;
